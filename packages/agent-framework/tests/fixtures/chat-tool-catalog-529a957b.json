{
 "version": "kapelle.chat-tools/v1",
 "tools": [
  {
   "name": "read_org_file",
   "description": "Read lines of one admitted organization file. Returns path#Lx-Ly lines and the file sha256.",
   "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path"
    ],
    "properties": {
     "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "fromLine": {
      "type": "integer",
      "minimum": 1
     },
     "toLine": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  {
   "name": "search_org_history",
   "description": "Search admitted organization files for words. Returns up to 8 short cited line windows.",
   "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "query"
    ],
    "properties": {
     "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
     }
    }
   }
  },
  {
   "name": "write_draft_artifact",
   "description": "Save a new version of a newsletter or agenda draft. Plain text fields only, except that a newsletter body may contain inline links written as [text](https://...); a link is kept only if its exact URL appears in the sources or in the member's own messages (or is mailto:hello@example.org). A body line \"1. text\" starts a numbered list and \"- text\" a bulleted one. headerPhotos (exactly four) and each section's images (up to four; position above, below, left or right, at most one beside the text; alt text; an optional plain caption) must be addresses from list_site_images: call it before placing or swapping photos. To change a draft, save a new version with the change. Every source must be a cited path and line.",
   "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "content"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "newsletter",
       "agenda"
      ]
     },
     "content": {
      "anyOf": [
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "title",
         "sections",
         "sources"
        ],
        "properties": {
         "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
         },
         "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "heading",
            "body"
           ],
           "properties": {
            "heading": {
             "type": "string",
             "minLength": 1,
             "maxLength": 200
            },
            "body": {
             "type": "string",
             "minLength": 1,
             "maxLength": 4000
            },
            "links": {
             "type": "array",
             "maxItems": 10,
             "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
               "text",
               "url"
              ],
              "properties": {
               "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
               },
               "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
               }
              }
             }
            },
            "images": {
             "type": "array",
             "maxItems": 4,
             "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
               "url",
               "alt",
               "position"
              ],
              "properties": {
               "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
               },
               "alt": {
                "type": "string",
                "maxLength": 200
               },
               "caption": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
               },
               "position": {
                "type": "string",
                "enum": [
                 "above",
                 "below",
                 "left",
                 "right"
                ]
               }
              }
             }
            }
           }
          }
         },
         "headerPhotos": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
           "type": "string",
           "minLength": 1,
           "maxLength": 500
          }
         },
         "sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "path",
            "line"
           ],
           "properties": {
            "path": {
             "type": "string",
             "minLength": 1,
             "maxLength": 300
            },
            "line": {
             "type": "integer",
             "minimum": 1
            }
           }
          }
         }
        }
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "meeting",
         "date",
         "items",
         "sources"
        ],
        "properties": {
         "meeting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
         },
         "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
         },
         "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "title"
           ],
           "properties": {
            "title": {
             "type": "string",
             "minLength": 1,
             "maxLength": 200
            },
            "owner": {
             "type": "string",
             "minLength": 1,
             "maxLength": 100
            },
            "note": {
             "type": "string",
             "minLength": 1,
             "maxLength": 1000
            }
           }
          }
         },
         "sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "path",
            "line"
           ],
           "properties": {
            "path": {
             "type": "string",
             "minLength": 1,
             "maxLength": 300
            },
            "line": {
             "type": "integer",
             "minimum": 1
            }
           }
          }
         }
        }
       }
      ]
     }
    }
   }
  },
  {
   "name": "render_newsletter_preview",
   "description": "Render a saved newsletter draft version as a preview for the member.",
   "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "artifactId",
     "version"
    ],
    "properties": {
     "artifactId": {
      "type": "string",
      "pattern": "^art_[a-f0-9]{32}$"
     },
     "version": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  {
   "name": "list_site_images",
   "description": "List the website images a newsletter may use: each address with a hint from its file name.",
   "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
   }
  }
 ]
}
